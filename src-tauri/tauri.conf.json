{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DeskCare",
  "version": "0.1.0",
  "identifier": "com.deskcare.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "tray-panel",
        "title": "",
        "width": 420,
        "height": 780,
        "visible": true,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": false,
        "shadow": true,
        "dragDropEnabled": true
      },
      {
        "label": "reminder-modal",
        "title": "DeskCare 提醒",
        "width": 360,
        "height": 480,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": true,
        "shadow": true,
        "closable": true,
        "dragDropEnabled": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": null,
      "nsis": null
    },
    "resources": [],
    "createUpdaterArtifacts": false
  }
}
